# Copy to .env and fill in. `.env` is gitignored.

# --- Model endpoint the eval harness talks to (OpenAI-compatible) ---
# Works with ANY endpoint, including your LOCAL MLX / llama.cpp server — point it at
# localhost to run the "gate on baseline" experiment with no GPU rental:
#   MODEL_ENDPOINT=http://localhost:8080/v1   MODEL_NAME=qwen3.6-35b-a3b   MODEL_API_KEY=local
# Hosted options for the 30B: OpenRouter https://openrouter.ai/api/v1
#   model qwen/qwen3-coder-30b-a3b-instruct (Together / Fireworks / DashScope also serve it).
MODEL_ENDPOINT=http://localhost:8080/v1
MODEL_NAME=qwen/qwen3-coder-30b-a3b-instruct
MODEL_API_KEY=local

# --- Eval knobs ---
EVAL_LIMIT=50              # SWE-bench subset size (full Verified = 500)
HARNESS=openhands          # openhands | mini
WORKSPACE=docker           # docker | remote | local  (use remote when the pod cannot run Docker)
DATASET=princeton-nlp/SWE-bench_Verified

# --- Terminal-Bench (eval/run_terminalbench.sh) ---
TB_LIMIT=25               # TB subset size (full terminal-bench-core ~80-100)
TB_DATASET=terminal-bench-core
TB_AGENT=terminus

# --- OpenHands benchmarks checkout (only for HARNESS=openhands) ---
# V1 eval harness lives in its own repo:
#   git clone https://github.com/OpenHands/benchmarks && cd benchmarks \
#     && git submodule update --init --recursive && make build
OPENHANDS_DIR=

# --- Hugging Face (dataset download + model push/pull) ---
HF_TOKEN=
